rules_version = '2';

// ForkRoad group sessions.
// Everyone signs in anonymously (app, iMessage extension, and web page).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function session(sessionId) {
      return get(/databases/$(database)/documents/sessions/$(sessionId)).data;
    }

    // Open, and the timer (if any) hasn't run out.
    function votingOpen(sessionId) {
      let s = session(sessionId);
      return s.status == 'open'
        && (!('closesAt' in s) || s.closesAt == null || request.time < s.closesAt);
    }

    // Still taking picks: open, and a vote's timer (if any) hasn't run out.
    function acceptsPicks(data) {
      return data.status == 'open'
        && (!('closesAt' in data) || data.closesAt == null || request.time < data.closesAt);
    }

    match /sessions/{sessionId} {
      // Anyone with the link (the session ID) can see a session...
      allow get: if signedIn();
      // ...but nobody can list them. Codes are looked up through joinCodes/.
      allow list: if false;

      // An "I'll pick" plan starts decided: exactly one place, which is the
      // winner, and a meeting time.
      function isNewPlan(data) {
        return data.mode == 'plan'
          && data.status == 'decided'
          && data.options.size() == 1
          && data.winnerID == data.options[0].id
          && data.meetTime is timestamp;
      }

      // "How many are eating?": optional, a whole number from 2 to 30.
      // Only the creator writes it (creating, or the creator's updates below).
      function validExpected(data) {
        return !('expectedCount' in data) || data.expectedCount == null
          || (data.expectedCount is int && data.expectedCount >= 2 && data.expectedCount <= 30);
      }

      // Group filters (1.1): optional, only these two keys, both bools.
      // Only the creator writes them (creating, or the creator's updates).
      function validFilters(data) {
        return !('groupFilters' in data) || data.groupFilters == null
          || (data.groupFilters is map
              && data.groupFilters.keys().hasOnly(['noFastFood', 'noCoffeeSweets'])
              && data.groupFilters.get('noFastFood', false) is bool
              && data.groupFilters.get('noCoffeeSweets', false) is bool);
      }

      // You can only create a session as yourself.
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && validExpected(request.resource.data)
        && validFilters(request.resource.data)
        && (request.resource.data.status == 'open' || isNewPlan(request.resource.data))
        && request.resource.data.options.size() <= 12;

      function addsMyOnePick() {
        let before = resource.data;
        let after = request.resource.data;
        let picksBefore = before.get('picksBy', {});
        let picksAfter = after.get('picksBy', {});
        return acceptsPicks(before)
          && before.get('surprise', false) != true
          && after.diff(before).affectedKeys().hasOnly(['options', 'picksBy'])
          // exactly one new place, nothing removed, still 12 or fewer
          && after.options.size() == before.options.size() + 1
          && after.options.size() <= 12
          && after.options.hasAll(before.options)
          // the new place is yours, and it's your first
          && after.options[before.options.size()].get('addedByID', '') == request.auth.uid
          && !(request.auth.uid in picksBefore)
          && picksAfter.diff(picksBefore).affectedKeys().hasOnly([request.auth.uid])
          && picksAfter[request.auth.uid] == after.options[before.options.size()].id;
      }

      // Swap your one pick for a different place while it's open: exactly
      // one place leaves (the one recorded as yours in picksBy) and exactly
      // one new place of yours takes its spot.
      function changesMyPick() {
        let before = resource.data;
        let after = request.resource.data;
        let picksBefore = before.get('picksBy', {});
        let picksAfter = after.get('picksBy', {});
        let removed = before.options.removeAll(after.options);
        let added = after.options.removeAll(before.options);
        return acceptsPicks(before)
          && before.get('surprise', false) != true
          && request.auth.uid in picksBefore
          && after.diff(before).affectedKeys().hasOnly(['options', 'picksBy'])
          && after.options.size() == before.options.size()
          && removed.size() == 1
          && added.size() == 1
          && removed[0].id == picksBefore[request.auth.uid]
          && added[0].get('addedByID', '') == request.auth.uid
          && picksAfter.diff(picksBefore).affectedKeys().hasOnly([request.auth.uid])
          && picksAfter[request.auth.uid] == added[0].id;
      }

      // The creator can change anything (lock in, meeting time, reopen, and
      // add up to 12 places to a vote).
      // Everyone else gets ONE pick per group, while it's open: they add one
      // place and record it under their own ID in picksBy. A second add fails,
      // but they can swap their pick for another place.
      allow update: if signedIn() && (
        (resource.data.createdBy == request.auth.uid && validExpected(request.resource.data)
          && validFilters(request.resource.data))
        || addsMyOnePick()
        || changesMyPick()
      );

      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;

      // One vote per person, written only by that person, only while voting is open.
      match /votes/{userId} {
        allow read: if signedIn();
        allow create, update: if signedIn() && request.auth.uid == userId && votingOpen(sessionId);
        // Take back your own vote while voting's open; the creator can clear
        // any vote when ending the group.
        allow delete: if signedIn() && (
          (request.auth.uid == userId && votingOpen(sessionId))
          || session(sessionId).createdBy == request.auth.uid
        );
      }

      // RSVPs for an "I'll pick" plan: one per person, written only by that
      // person, while the creator is asking and before the reply-by time.
      function rsvpOpen(sessionId) {
        let s = session(sessionId);
        return s.get('asksRSVP', false) == true
          && (s.get('rsvpBy', null) == null || request.time < s.rsvpBy);
      }

      function validRSVP(userId) {
        let d = request.resource.data;
        return d.keys().hasOnly(['userID', 'name', 'going', 'guests', 'answeredAt'])
          && d.userID == userId
          && d.name is string && d.name.size() > 0 && d.name.size() <= 40
          && d.going is bool
          && d.guests is int && d.guests >= 0 && d.guests <= 4
          && (d.going || d.guests == 0);
      }

      match /rsvps/{userId} {
        allow read: if signedIn();
        allow create, update: if signedIn() && request.auth.uid == userId
          && rsvpOpen(sessionId) && validRSVP(userId);
        // Take back your own answer while replies are open; the creator can
        // clear them all when ending the plan.
        allow delete: if signedIn() && (
          (request.auth.uid == userId && rsvpOpen(sessionId))
          || session(sessionId).createdBy == request.auth.uid
        );
      }

      // This phone's Lock Screen countdown settings and ActivityKit push
      // tokens (1.1). Private: only you write and read yours; the server
      // (admin SDK) reads them to start, update, and end the countdown, and
      // keeps laStartedFor / laEndedFor here, which apps can't touch.
      function validDevice() {
        let d = request.resource.data;
        let clientKeys = ['leadMinutes', 'removeWhen', 'apnsEnv', 'countdownOn', 'startToken',
                          'updateToken', 'activityMeet', 'leaveAt', 'travelMinutes', 'planMeet', 'updatedAt'];
        let changed = resource == null ? d.keys() : d.diff(resource.data).affectedKeys();
        return changed.hasOnly(clientKeys)
          && d.size() <= 20
          && (!('leadMinutes' in d) || (d.leadMinutes is int && d.leadMinutes >= 60 && d.leadMinutes <= 480))
          && (!('removeWhen' in d) || d.removeWhen in ['arrive', 'meet', 'after30', 'after60'])
          && (!('apnsEnv' in d) || d.apnsEnv in ['sandbox', 'production'])
          && (!('countdownOn' in d) || d.countdownOn is bool)
          && (!('startToken' in d) || (d.startToken is string && d.startToken.size() <= 400))
          && (!('updateToken' in d) || (d.updateToken is string && d.updateToken.size() <= 400))
          && (!('travelMinutes' in d) || (d.travelMinutes is int && d.travelMinutes >= 0 && d.travelMinutes <= 1440));
      }

      match /devices/{userId} {
        allow get: if signedIn() && request.auth.uid == userId;
        allow list: if false;
        // Only for a plan that still exists (no orphan docs from old plans).
        allow create, update: if signedIn() && request.auth.uid == userId && validDevice()
          && exists(/databases/$(database)/documents/sessions/$(sessionId));
        allow delete: if signedIn() && (
          request.auth.uid == userId || session(sessionId).createdBy == request.auth.uid
        );
      }

      // "On my way" (1.1): your arrival time and status, never a location.
      // Only you write yours; anyone in the plan can read them. Only for a
      // decided plan. Deleted with the plan (and by the server after it).
      function validETA(userId) {
        let d = request.resource.data;
        return d.keys().hasOnly(['userID', 'name', 'eta', 'etaLabel', 'leftAt', 'status', 'lateMinutes', 'lateNote', 'updatedAt'])
          && (!('etaLabel' in d) || d.etaLabel == null || (d.etaLabel is string && d.etaLabel.size() <= 24))
          && d.userID == userId
          && d.name is string && d.name.size() > 0 && d.name.size() <= 40
          && d.status in ['onTheWay', 'late', 'arrived']
          && (!('eta' in d) || d.eta == null || d.eta is timestamp)
          && (!('leftAt' in d) || d.leftAt == null || d.leftAt is timestamp)
          && (!('lateMinutes' in d) || d.lateMinutes == null || d.lateMinutes in [10, 15, 30])
          && (!('lateNote' in d) || d.lateNote == null || d.lateNote in ['text']);
      }

      match /eta/{userId} {
        allow read: if signedIn();
        allow create, update: if signedIn() && request.auth.uid == userId
          && session(sessionId).status == 'decided' && validETA(userId);
        allow delete: if signedIn() && (
          request.auth.uid == userId || session(sessionId).createdBy == request.auth.uid
        );
      }

      // Members list: you can only add or edit yourself.
      match /members/{userId} {
        allow read: if signedIn();
        allow create, update: if signedIn() && request.auth.uid == userId;
        // Leave a group yourself; the creator can remove everyone when ending it.
        allow delete: if signedIn() && (
          request.auth.uid == userId || session(sessionId).createdBy == request.auth.uid
        );
      }
    }

    // ---------------------------------------------------------------------
    // Usage stats: stats/{yyyy-mm-dd} holds one anonymous count per thing
    // per day (UTC). Anyone signed in can add exactly 1 to one known count,
    // for today (give or take a day for time zones). Only admins can read.
    function statFields() {
      return ['activeDevices', 'newDevices', 'spins', 'groupsVote', 'groupsSpin', 'groupsPlan', 'rsvps',
              'groupPicks', 'customPlaces', 'webVisitors', 'webVotes', 'webPicks'];
    }

    // An admin has a document at admins/{their user ID}, created by hand in
    // the Firebase console (the stats page shows the ID to use).
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isAboutToday(day) {
      let parts = day.split('-');
      let date = timestamp.date(int(parts[0]), int(parts[1]), int(parts[2]));
      return day.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$')
        && request.time > date - duration.value(1, 'd')
        && request.time < date + duration.value(2, 'd');
    }

    match /stats/{day} {
      allow read: if isAdmin();
      allow create: if signedIn() && isAboutToday(day)
        && request.resource.data.keys().size() == 1
        && request.resource.data.keys().hasOnly(statFields())
        && request.resource.data[request.resource.data.keys()[0]] == 1;
      // Exactly one known count changes, and only by +1. (Rules sets have no
      // toList(), so the old "bump the first affected key" check errored and
      // denied every update: only each day's first count ever landed.)
      allow update: if signedIn() && isAboutToday(day)
        && request.resource.data.diff(resource.data).affectedKeys().size() == 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(statFields())
        && sameOrPlusOne('activeDevices') && sameOrPlusOne('newDevices') && sameOrPlusOne('spins')
        && sameOrPlusOne('groupsVote') && sameOrPlusOne('groupsSpin') && sameOrPlusOne('groupsPlan')
        && sameOrPlusOne('rsvps') && sameOrPlusOne('groupPicks') && sameOrPlusOne('customPlaces')
        && sameOrPlusOne('webVisitors') && sameOrPlusOne('webVotes') && sameOrPlusOne('webPicks');
    }

    function sameOrPlusOne(field) {
      let before = resource.data.get(field, 0);
      let after = request.resource.data.get(field, 0);
      return after == before || after == before + 1;
    }

    // Admins list: you can check whether you're one; nobody can write it from
    // an app (add yourself in the Firebase console).
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // joinCodes/{code} → { sessionId, createdBy }. Look up one code at a time.
    match /joinCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && session(request.resource.data.sessionId).createdBy == request.auth.uid
        && session(request.resource.data.sessionId).joinCode == code;
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }
  }
}
