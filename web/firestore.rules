rules_version = '2';

// ForkRoad group sessions.
// Everyone signs in anonymously (app, iMessage extension, and web page).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function session(sessionId) {
      return get(/databases/$(database)/documents/sessions/$(sessionId)).data;
    }

    // Open, and the timer (if any) hasn't run out.
    function votingOpen(sessionId) {
      let s = session(sessionId);
      return s.status == 'open'
        && (!('closesAt' in s) || s.closesAt == null || request.time < s.closesAt);
    }

    match /sessions/{sessionId} {
      // Anyone with the link (the session ID) can see a session...
      allow get: if signedIn();
      // ...but nobody can list them. Codes are looked up through joinCodes/.
      allow list: if false;

      // You can only create a session as yourself.
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.options.size() <= 12;

      function addsMyOnePick() {
        let before = resource.data;
        let after = request.resource.data;
        let picksBefore = before.get('picksBy', {});
        let picksAfter = after.get('picksBy', {});
        return before.status == 'open'
          && after.diff(before).affectedKeys().hasOnly(['options', 'picksBy'])
          // exactly one new place, nothing removed, still 12 or fewer
          && after.options.size() == before.options.size() + 1
          && after.options.size() <= 12
          && after.options.hasAll(before.options)
          // the new place is yours, and it's your first
          && after.options[before.options.size()].get('addedByID', '') == request.auth.uid
          && !(request.auth.uid in picksBefore)
          && picksAfter.diff(picksBefore).affectedKeys().hasOnly([request.auth.uid])
          && picksAfter[request.auth.uid] == after.options[before.options.size()].id;
      }

      // Swap your one pick for a different place while it's open: exactly
      // one place leaves (the one recorded as yours in picksBy) and exactly
      // one new place of yours takes its spot.
      function changesMyPick() {
        let before = resource.data;
        let after = request.resource.data;
        let picksBefore = before.get('picksBy', {});
        let picksAfter = after.get('picksBy', {});
        let removed = before.options.removeAll(after.options);
        let added = after.options.removeAll(before.options);
        return before.status == 'open'
          && request.auth.uid in picksBefore
          && after.diff(before).affectedKeys().hasOnly(['options', 'picksBy'])
          && after.options.size() == before.options.size()
          && removed.size() == 1
          && added.size() == 1
          && removed[0].id == picksBefore[request.auth.uid]
          && added[0].get('addedByID', '') == request.auth.uid
          && picksAfter.diff(picksBefore).affectedKeys().hasOnly([request.auth.uid])
          && picksAfter[request.auth.uid] == added[0].id;
      }

      // The creator can change anything (lock in, meeting time, reopen, and
      // add up to 12 places to a vote).
      // Everyone else gets ONE pick per group, while it's open: they add one
      // place and record it under their own ID in picksBy. A second add fails,
      // but they can swap their pick for another place.
      allow update: if signedIn() && (
        resource.data.createdBy == request.auth.uid
        || addsMyOnePick()
        || changesMyPick()
      );

      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;

      // One vote per person, written only by that person, only while voting is open.
      match /votes/{userId} {
        allow read: if signedIn();
        allow create, update: if signedIn() && request.auth.uid == userId && votingOpen(sessionId);
        // Take back your own vote while voting's open; the creator can clear
        // any vote when ending the group.
        allow delete: if signedIn() && (
          (request.auth.uid == userId && votingOpen(sessionId))
          || session(sessionId).createdBy == request.auth.uid
        );
      }

      // Members list: you can only add or edit yourself.
      match /members/{userId} {
        allow read: if signedIn();
        allow create, update: if signedIn() && request.auth.uid == userId;
        // Leave a group yourself; the creator can remove everyone when ending it.
        allow delete: if signedIn() && (
          request.auth.uid == userId || session(sessionId).createdBy == request.auth.uid
        );
      }
    }

    // joinCodes/{code} → { sessionId, createdBy }. Look up one code at a time.
    match /joinCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && session(request.resource.data.sessionId).createdBy == request.auth.uid
        && session(request.resource.data.sessionId).joinCode == code;
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }
  }
}
